        function eksporDataCSV() {
            let data = storageOrganisasi[kategoriArsipAktif];
            if(data.length === 0) return;
            let csvRows = data.map(item => { let newItem = {...item}; delete newItem.foto; return Object.values(newItem).join(","); });
            let csvContent = "data:text/csv;charset=utf-8," + Object.keys(data[0]).filter(k => k !== 'foto').join(",") + "\n" + csvRows.join("\n");
            let encodedUri = encodeURI(csvContent);
            let link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `data_${kategoriArsipAktif}.csv`);
            document.body.appendChild(link); link.click();
        }

        function eksporDataPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF('l', 'mm', 'a4');
            const judul = document.getElementById('judul-halaman-arsip').innerText;
            doc.setFontSize(16); doc.text(judul, 14, 15);
            doc.setFontSize(10); doc.text("Laporan Sistem Administrasi Digital Pagar Nusa Qolbu Mukmin", 14, 22);
            doc.autoTable({ html: '#tabel-arsip-utama', startY: 35, theme: 'striped', headStyles: { fillColor: [16, 185, 129], fontSize: 8 }, bodyStyles: { fontSize: 7 }, columnStyles: { last: { display: 'none' } } });
            doc.save(`laporan_${kategoriArsipAktif}_${Date.now()}.pdf`);
        }
