        function jalankanFiturFilter() {
            const valNia = document.getElementById('filter-nia-status') ? document.getElementById('filter-nia-status').value : "";
            const valJk = document.getElementById('filter-jk') ? document.getElementById('filter-jk').value : "";
            const valTingkat = document.getElementById('filter-tingkat') ? document.getElementById('filter-tingkat').value : "";
            const valSurat = document.getElementById('filter-jenis-surat') ? document.getElementById('filter-jenis-surat').value : "";
            const valKeu = document.getElementById('filter-tipe-keu') ? document.getElementById('filter-tipe-keu').value : "";
            const valPk = document.getElementById('filter-status-pk') ? document.getElementById('filter-status-pk').value : "";
            
            document.querySelectorAll('.item-row').forEach(row => {
                let show = true;
                if(valNia) {
                    const cell = row.querySelector('.data-nia-val');
                    if(cell && !cell.innerText.includes(valNia)) show = false;
                }
                if(valJk) {
                    const cell = row.querySelector('.data-jk');
                    if(cell && cell.innerText !== valJk) show = false;
                }
                if(valTingkat) {
                    const cell = row.querySelector('.data-tingkat');
                    if(cell && !cell.innerText.includes(valTingkat)) show = false;
                }
                if(valSurat) {
                    const cell = row.querySelector('.data-jenis-surat');
                    if(cell && cell.innerText !== valSurat) show = false;
                }
                if(valKeu) {
                    const cell = row.querySelector('.data-tipe-keu');
                    if(cell && cell.innerText !== valKeu) show = false;
                }
                if(valPk) {
                    const cell = row.querySelector('.data-status-pk');
                    if(cell && cell.innerText !== valPk) show = false;
                }
                row.style.display = show ? '' : 'none';
            });
        }

