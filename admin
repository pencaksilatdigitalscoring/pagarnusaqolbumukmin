        async function prosesRegistrasi(event) {
            event.preventDefault();
            const btn = event.submitter;
            btn.disabled = true;
            btn.innerText = "Mengirim...";

            const id = Date.now();
            const fotoFile = document.getElementById('reg_foto').files[0];
            let base64Foto = "";
            if (fotoFile) base64Foto = await getBase64(fotoFile);

            const data = {
                id: id,
                nama_lengkap: document.getElementById('reg_nama').value,
                nia: document.getElementById('reg_nia').value,
                nik: document.getElementById('reg_nik').value,
                user_login: document.getElementById('reg_user').value,
                pass_login: document.getElementById('reg_pass').value,
                kk: document.getElementById('reg_kk').value,
                whatsapp: document.getElementById('reg_wa').value,
                jenis_kelamin: document.getElementById('reg_jk').value,
                tanggal_lahir: document.getElementById('reg_tgl').value,
                ranting_rayon: document.getElementById('reg_rayon').value,
                alamat: document.getElementById('reg_alamat').value,
                foto: base64Foto,
                kualifikasi_usia: hitungUsiaManual(document.getElementById('reg_tgl').value),
                tanggal_daftar: new Date().toISOString()
            };

            database.ref('pending_registrasi/' + id).set(data).then(() => {
                alert("Pendaftaran Berhasil Terkirim! Mohon tunggu konfirmasi admin.");
                document.getElementById('page-register').querySelector('form').reset();
                switchPage('page-login');
            }).catch(e => alert(e.message));
        }

        function hitungUsiaManual(tgl) {
            const lahir = new Date(tgl);
            const sekarang = new Date();
            let usia = sekarang.getFullYear() - lahir.getFullYear();
            if (sekarang.getMonth() < lahir.getMonth() || (sekarang.getMonth() === lahir.getMonth() && sekarang.getDate() < lahir.getDate())) usia--;
            return usia <= 11 ? "Usia Dini" : usia <= 14 ? "Pra Remaja" : usia <= 17 ? "Remaja" : "Dewasa";
        }

