        async function prosesSimpanData(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSimpanSistem');
            const kategori = document.getElementById('kategoriUtama').value;
            let idFinal = editIdAktif ? editIdAktif : Date.now();
            let dataEntri = { id: idFinal };

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Memproses Data...</span>`;

            let fileInput = document.getElementById('field_file') || 
                            document.getElementById('field_file_keu') || 
                            document.getElementById('field_file_surat') || 
                            document.getElementById('field_file_agenda');
            
            let fileData = "";
            if (fileInput && fileInput.files[0]) fileData = await getBase64(fileInput.files[0]);

            if (kategori === "anggota") {
                dataEntri.foto = fileData || (editIdAktif ? storageOrganisasi[kategori].find(x => x.id == idFinal).foto : "https://via.placeholder.com/100");
                dataEntri.nik = document.getElementById('field_nik').value;
                dataEntri.kk = document.getElementById('field_kk').value;
                dataEntri.whatsapp = document.getElementById('field_wa').value;
                dataEntri.nia = document.getElementById('field_nia').value;
                dataEntri.nama_lengkap = document.getElementById('field_nama').value;
                dataEntri.jenis_kelamin = document.getElementById('field_jk').value;
                dataEntri.tanggal_lahir = document.getElementById('field_tgl').value;
                dataEntri.kualifikasi_usia = document.getElementById('field_kualifikasi_usia').value;
                dataEntri.ranting_rayon = document.getElementById('field_rayon_asal').value;
                dataEntri.alamat = document.getElementById('field_alamat').value;
            } else if (kategori === "pelatih" || kategori === "kepengurusan") {
                dataEntri.foto = fileData || fotoAutoFill || "https://via.placeholder.com/100";
                dataEntri.nama_lengkap = document.getElementById('field_nama').value;
                dataEntri.nia = document.getElementById('field_nia').value;
                dataEntri.whatsapp = document.getElementById('field_wa').value;
                dataEntri.nik = document.getElementById('field_nik').value;
                dataEntri.kk = document.getElementById('field_kk').value;
                dataEntri.jenis_kelamin = document.getElementById('field_jk').value;
                dataEntri.alamat = document.getElementById('field_alamat').value;
                dataEntri.ranting_rayon = document.getElementById('field_rayon_asal').value;
                if(kategori === 'kepengurusan') {
                    dataEntri.jabatan = document.getElementById('field_jabatan').value;
                    dataEntri.tingkat = document.getElementById('field_tingkat').value;
                    const dataAnggota = storageOrganisasi.anggota.find(a => a.nama_lengkap === dataEntri.nama_lengkap);
                    if(dataAnggota) dataEntri.tanggal_lahir = dataAnggota.tanggal_lahir;
                } else {
                    const dataAnggota = storageOrganisasi.anggota.find(a => a.nama_lengkap === dataEntri.nama_lengkap);
                    if(dataAnggota) {
                        dataEntri.tanggal_lahir = dataAnggota.tanggal_lahir;
                        dataEntri.kualifikasi_usia = dataAnggota.kualifikasi_usia;
