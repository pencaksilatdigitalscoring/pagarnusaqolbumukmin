        function inisialisasiDataRealtime() {
            database.ref('administrasi_digital').on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    Object.keys(storageOrganisasi).forEach(key => {
                        storageOrganisasi[key] = data[key] ? Object.values(data[key]) : [];
                    });
                } else {
                    Object.keys(storageOrganisasi).forEach(key => storageOrganisasi[key] = []);
                }
                segarkanDashboardStatistik();
                if (!document.getElementById('page-arsip-view').classList.contains('hidden')) renderListArsip();
            });

            // Monitor Pending Registrasi
            database.ref('pending_registrasi').on('value', (snapshot) => {
                const data = snapshot.val();
                dataPending = data ? Object.entries(data).map(([id, val]) => ({...val, id})) : [];
                const badge = document.getElementById('badge-notif');
                if (dataPending.length > 0) {
                    badge.innerText = dataPending.length;
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
                renderListPending();
            });
        }

