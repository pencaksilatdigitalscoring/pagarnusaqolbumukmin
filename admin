<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- KUNCI LAYAR AGAR TIDAK BISA DI ZOOM -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sistem Administrasi Digital</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <!-- PDF Export Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

    <style>
        /* Mencegah seleksi teks berlebih dan touch delay */
        body {
            touch-action: manipulation;
            -webkit-user-select: none;
            user-select: none;
        }
        input, textarea, select {
            -webkit-user-select: text;
            user-select: text;
        }
        .checkmark-circle {
            width: 80px; height: 80px;
            border-radius: 50%;
            border: 4px solid #10b981;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 15px;
            animation: scaleIn 0.3s ease-out forwards;
        }
        .checkmark-icon {
            font-size: 40px; color: #10b981;
            animation: drawCheck 0.2s 0.2s ease-out forwards;
            opacity: 0; transform: scale(0.5);
        }
        @keyframes scaleIn { 0% { transform: scale(0); } 100% { transform: scale(1); } }
        @keyframes drawCheck { 0% { opacity: 0; transform: scale(0.5); } 100% { opacity: 1; transform: scale(1); } }
        
        .table-container {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10px;
        }
        th {
            background-color: #f8fafc;
            text-align: left;
            padding: 8px;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        td {
            padding: 8px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            color: #1e293b;
        }
        .img-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .img-circle:hover {
            transform: scale(1.1);
            border-color: #10b981;
        }
        .card-link {
            cursor: pointer;
            transition: all 0.2s;
        }
        .card-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased">

    <!-- CONTAINER UTAMA -->
    <div id="app-container" class="max-w-md mx-auto bg-white min-h-screen shadow-xl flex flex-col relative overflow-x-hidden">
        
        <!-- PAGE LOGIN (KUNCI LAYAR) -->
        <section id="page-login" class="absolute inset-0 z-[200] bg-white flex flex-col items-center justify-center p-8">
            <div class="mb-6 flex flex-col items-center">
                <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mb-4 border-4 border-emerald-500">
                    <i class="fa-solid fa-lock text-4xl text-emerald-600"></i>
                </div>
                <h2 class="text-xl font-black text-slate-800 text-center uppercase tracking-tighter leading-tight">PAGAR NUSA QOLBU MUKMIN<br><span class="text-emerald-600">DATABASE SYSTEM</span></h2>
                <p class="text-[10px] text-slate-400 mt-2 font-bold uppercase tracking-widest">Sistem Administrasi Digital</p>
            </div>
            
            <div class="w-full space-y-3">
                <input type="text" id="login-user" placeholder="Nama Pengguna" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-emerald-500">
                <input type="password" id="login-pass" placeholder="Kata Sandi" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-emerald-500">
                <button onclick="prosesLogin()" class="w-full bg-emerald-600 text-white font-bold py-3 rounded-xl shadow-lg hover:bg-emerald-700 transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket"></i> MASUK SISTEM
                </button>
                <div class="pt-4 text-center">
                    <p class="text-[10px] text-slate-400 mb-2">Belum terdaftar sebagai anggota?</p>
                    <button onclick="switchPage('page-register')" class="text-xs font-bold text-emerald-600 hover:underline">DAFTAR ANGGOTA BARU</button>
                </div>
            </div>
        </section>

        <!-- PAGE REGISTER -->
        <section id="page-register" class="hidden absolute inset-0 z-[210] bg-white flex flex-col p-6 overflow-y-auto">
            <div class="flex items-center gap-3 mb-6">
                <button onclick="switchPage('page-login')" class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600"><i class="fa-solid fa-arrow-left text-xs"></i></button>
                <h3 class="text-sm font-bold text-slate-800 uppercase">Form Registrasi Mandiri</h3>
            </div>
            
            <form onsubmit="prosesRegistrasi(event)" class="space-y-4 pb-10">
                <div class="bg-emerald-50 p-4 rounded-xl mb-2 text-center border border-emerald-100">
                    <p class="text-[10px] text-emerald-700 font-bold uppercase">Lengkapi data di bawah ini untuk pengajuan pendataan database resmi.</p>
                </div>

                <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Nama Lengkap (Sesuai KTP)</label><input type="text" id="reg_nama" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                
                <div class="grid grid-cols-2 gap-2">
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Nomor Induk Anggota (NIA)</label><input type="text" id="reg_nia" oninput="updateAutoUser()" placeholder="Jika ada" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">NIK (KTP)</label><input type="number" id="reg_nik" oninput="updateAutoUser()" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                </div>

                <!-- KOLOM USER DAN PASSWORD BARU -->
                <div class="grid grid-cols-2 gap-2 p-3 bg-slate-100 rounded-xl border border-dashed border-slate-300">
                    <div><label class="block text-[10px] font-bold text-emerald-700 mb-1 italic">User Login (Otomatis)</label><input type="text" id="reg_user" readonly class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2.5 font-bold text-emerald-600"></div>
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Kata Sandi Akun</label><input type="text" id="reg_pass" required placeholder="Buat sandi" class="w-full text-xs bg-white border border-slate-200 rounded-lg px-3 py-2.5"></div>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">WhatsApp</label><input type="number" id="reg_wa" placeholder="628..." required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">No. Kartu Keluarga</label><input type="number" id="reg_kk" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Jenis Kelamin</label><select id="reg_jk" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"><option value="Laki-laki">Laki-laki</option><option value="Perempuan">Perempuan</option></select></div>
                    <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Tanggal Lahir</label><input type="date" id="reg_tgl" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></div>
                </div>
                <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Pilih Rayon/Ranting</label><select id="reg_rayon" required class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></select></div>
                <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Alamat Domisili Lengkap</label><textarea id="reg_alamat" required rows="2" class="w-full text-xs bg-slate-50 border border-slate-200 rounded-lg px-3 py-2.5"></textarea></div>
                <div><label class="block text-[10px] font-bold text-slate-600 mb-1">Pas Foto (JPG/PNG)</label><input type="file" id="reg_foto" accept="image/*" required class="w-full text-[10px] bg-slate-50 border border-slate-200 rounded-lg px-2 py-2"></div>

                <button type="submit" class="w-full bg-emerald-600 text-white font-bold py-3 rounded-xl shadow-lg mt-4 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i> KIRIM PENGAJUAN DATA
                </button>
            </form>
        </section>

        <!-- HEADER HALAMAN -->
        <header class="bg-emerald-600 text-white p-4 sticky top-0 z-50 shadow-md">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <button onclick="toggleSidebar(true)" class="w-10 h-10 rounded-xl bg-emerald-500/50 flex items-center justify-center hover:bg-emerald-500 transition-colors focus:outline-none">
                        <i class="fa-solid fa-bars text-lg"></i>
                    </button>
                    <div>
                        <h1 class="text-lg font-bold tracking-wide">PANEL UTAMA</h1>
                        <p class="text-xs text-emerald-100">Pusat Data & Statistik Organisasi</p>
                    </div>
                </div>
                <button onclick="bukaModalNotifikasi()" class="relative w-10 h-10 rounded-full bg-emerald-500/50 flex items-center justify-center hover:bg-emerald-500 transition-colors">
                    <i class="fa-solid fa-bell"></i>
                    <span id="badge-notif" class="hidden absolute top-1 right-1 w-4 h-4 bg-rose-500 border-2 border-emerald-600 rounded-full text-[8px] font-bold flex items-center justify-center text-white">0</span>
                </button>
            </div>
        </header>

        <!-- SIDEBAR DRAWER MENU -->
        <div id="sidebar-menu" class="absolute inset-y-0 left-0 w-72 bg-slate-900 text-slate-200 z-[100] shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between">
            <div>
                <div class="p-4 bg-slate-950 border-b border-slate-800 flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-folder-tree text-emerald-500 text-lg"></i>
                        <span class="font-bold text-sm tracking-wide text-white">PAGAR NUSA QOLBU MUKMIN</span>
                    </div>
                    <button onclick="toggleSidebar(false)" class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-colors">
                        <i class="fa-solid fa-xmark text-sm"></i>
                    </button>
                </div>
                <div class="p-3 space-y-1">
                    <button onclick="pilihMenu('page-statistik')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-bold bg-emerald-600 text-white shadow-sm text-left transition-all">
                        <i class="fa-solid fa-chart-simple w-4 text-center"></i> Dashboard & Statistik
                    </button>
                    <button onclick="pilihMenu('page-form')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-circle-plus w-4 text-center"></i> Form Input Data Terpadu
                    </button>
                    
                    <div class="pt-4 pb-2 px-4">
                        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Arsip Komponen Data</span>
                    </div>

                    <button onclick="bukaHalamanArsip('anggota')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-users w-4 text-center text-emerald-400"></i> Data Anggota
                    </button>
                    <button onclick="bukaHalamanArsip('pelatih')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-user-shield w-4 text-center text-blue-400"></i> Data Pelatih
                    </button>
                    <button onclick="bukaHalamanArsip('rayon')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-map-location-dot w-4 text-center text-purple-400"></i> Data Rayon & Ranting
                    </button>
                    <button onclick="bukaHalamanArsip('kepengurusan')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-sitemap w-4 text-center text-indigo-400"></i> Data Kepengurusan
                    </button>
                    <button onclick="bukaHalamanArsip('keuangan')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-wallet w-4 text-center text-emerald-400"></i> Data Laporan Keuangan
                    </button>
                    <button onclick="bukaHalamanArsip('administrasi')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-file-invoice w-4 text-center text-cyan-400"></i> Data Administrasi (Surat)
                    </button>
                    <button onclick="bukaHalamanArsip('program_kerja')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-layer-group w-4 text-center text-amber-400"></i> Data Program Kerja
                    </button>
                    <button onclick="bukaHalamanArsip('agenda')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-calendar-days w-4 text-center text-teal-400"></i> Data Agenda
                    </button>
                    <button onclick="bukaHalamanArsip('evaluasi')" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800 hover:text-white text-left transition-all">
                        <i class="fa-solid fa-triangle-exclamation w-4 text-center text-rose-400"></i> Data Evaluasi
                    </button>
                </div>
            </div>
            <div class="p-4 bg-slate-950 text-center text-[10px] text-slate-500 border-t border-slate-800 space-y-1">
                <button onclick="window.location.reload()" class="text-rose-400 font-bold mb-2">KELUAR (LOGOUT)</button>
                <p>Sistem Administrasi Berjalan v3.1</p>
            </div>
        </div>

        <!-- OVERLAY SIDEBAR -->
        <div id="sidebar-overlay" onclick="toggleSidebar(false)" class="absolute inset-0 bg-black/50 z-50 hidden transition-opacity duration-300"></div>

        <!-- KONTEN UTAMA PAGES -->
        <main class="flex-1 p-4 space-y-6">

            <!-- PAGE 1: DASHBOARD UTAMA -->
            <section id="page-statistik" class="space-y-4">
                <div id="dashboard-content" class="space-y-4 pb-8">
                    <div class="p-8 text-center text-slate-400">Memuat data dashboard...</div>
                </div>
            </section>

            <!-- PAGE 2: FORM INPUT DATA -->
            <section id="page-form" class="hidden space-y-4">
                <div class="flex items-center gap-2 mb-2">
                    <button onclick="switchPage('page-statistik')" class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600"><i class="fa-solid fa-arrow-left text-xs"></i></button>
                    <h3 class="text-sm font-bold text-slate-800">Form Input Data</h3>
                </div>
                
                <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/60 space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Kategori Utama</label>
                        <select id="kategoriUtama" onchange="renderFormFields()" class="w-full text-xs bg-white border border-slate-200 rounded-xl px-3 py-2.5 shadow-sm focus:outline-none focus:border-emerald-500 font-semibold">
                            <option value="anggota">Anggota</option>
                            <option value="pelatih">Pelatih</option>
                            <option value="rayon">Rayon / Ranting</option>
                            <option value="kepengurusan">Kepengurusan</option>
                            <option value="keuangan">Laporan Keuangan</option>
                            <option value="administrasi">Administrasi (Surat)</option>
                            <option value="program_kerja">Program Kerja</option>
                            <option value="agenda">Agenda</option>
                            <option value="evaluasi">Evaluasi</option>
                        </select>
                    </div>

                    <form id="formDinamisSistem" onsubmit="prosesSimpanData(event)" class="space-y-3">
                        <div id="wadah-input-dinamis" class="space-y-3"></div>
                        <button type="submit" id="btnSimpanSistem" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-3 rounded-xl shadow-md transition-all mt-4 flex items-center justify-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-up"></i> <span>Simpan ke Sistem</span>
                        </button>
                    </form>
                </div>
            </section>

            <!-- PAGE 3: VIEW DATA ARSIP -->
            <section id="page-arsip-view" class="hidden space-y-4">
                <div class="flex flex-col gap-3">
                    <div class="flex justify-between items-center">
                        <h3 id="judul-halaman-arsip" class="text-sm font-bold text-slate-800 uppercase tracking-wider">Data Arsip</h3>
                        <div class="flex gap-1.5">
                            <button onclick="eksporDataCSV()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-file-export"></i> CSV
                            </button>
                            <button onclick="eksporDataPDF()" class="bg-rose-600 hover:bg-rose-700 text-white text-[10px] font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-file-pdf"></i> PDF
                            </button>
                        </div>
                    </div>
                    
                    <!-- FILTER BAR RESPONSIVE -->
                    <div id="wadah-filter-khusus" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-2 mb-1"></div>

                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </span>
                        <input type="text" id="inputCariArsip" oninput="jalankanFiturCari()" placeholder="Cari data..." class="w-full text-xs pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl shadow-sm focus:outline-none">
                    </div>
                </div>

                <div class="table-container bg-white rounded-xl border border-slate-200 shadow-sm">
                    <div id="container-list-arsip"></div>
                </div>
            </section>
        </main>

        <!-- MODAL NOTIFIKASI (APPROVAL) -->
        <div id="modal-notif" class="fixed inset-0 bg-black/60 z-[250] hidden flex flex-col p-4">
            <div class="bg-white rounded-2xl w-full max-w-sm mx-auto flex flex-col max-h-[80vh] shadow-2xl">
                <div class="p-4 border-b border-slate-100 flex justify-between items-center">
                    <h4 class="text-xs font-bold text-slate-800 uppercase">Konfirmasi Pendaftaran Anggota</h4>
                    <button onclick="tutupModalNotifikasi()" class="text-slate-400"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div id="list-pending-registrasi" class="flex-1 overflow-y-auto p-3 space-y-3">
                    <div class="text-center p-8 text-xs text-slate-400">Tidak ada pengajuan baru.</div>
                </div>
            </div>
        </div>

        <!-- MODAL SUCCESS -->
        <div id="modal-success" class="fixed inset-0 bg-black/60 z-[300] hidden flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl p-6 w-full max-w-xs text-center shadow-2xl">
                <div class="checkmark-circle"><i class="fa-solid fa-check checkmark-icon"></i></div>
                <h4 class="text-base font-bold text-slate-900">Data Berhasil Disimpan</h4>
                <p class="text-xs text-slate-500 mt-1">Database cloud berhasil diperbarui.</p>
            </div>
        </div>

        <!-- MODAL PREVIEW FOTO -->
        <div id="modal-foto" class="fixed inset-0 bg-black/80 z-[350] hidden flex items-center justify-center p-4" onclick="tutupPopUpFoto()">
            <div class="relative max-w-sm w-full bg-white rounded-2xl overflow-hidden p-2 shadow-2xl transform scale-95 transition-transform duration-300" onclick="event.stopPropagation()">
                <button onclick="tutupPopUpFoto()" class="absolute top-4 right-4 w-10 h-10 bg-black/20 hover:bg-black/50 text-white rounded-full flex items-center justify-center backdrop-blur-md transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                <img id="preview-foto-besar" src="" class="w-full h-auto rounded-xl object-contain max-h-[70vh]">
                <div class="p-3 text-center">
                    <p id="preview-nama-foto" class="text-sm font-bold text-slate-800"></p>
                    <p class="text-[10px] text-slate-500">Preview Berkas Digital</p>
                </div>
            </div>
        </div>

        <footer class="p-3 bg-slate-50 text-center text-[10px] text-slate-400 border-t border-slate-100">
            Sistem Kelola Data Mandiri Terintegrasi
        </footer>
    </div>

