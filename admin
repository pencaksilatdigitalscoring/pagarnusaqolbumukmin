            } else if (kategori === "keuangan") {
                dataEntri.tipe = document.getElementById('field_tipe_keu').value;
                dataEntri.tanggal = document.getElementById('field_tgl_keu').value;
                dataEntri.nominal = document.getElementById('field_nominal_keu').value;
                dataEntri.keterangan = document.getElementById('field_ket_keu').value;
