                }
            } else if (kategori === "rayon") {
                dataEntri.nama_rayon_ranting = document.getElementById('field_nama_rr').value;
                dataEntri.kategori_rr = document.getElementById('field_kat_rr').value;
                dataEntri.lokasi_latihan = document.getElementById('field_lokasi_rr').value;
                dataEntri.jadwal_hari = document.getElementById('field_jadwal_rr').value;
                dataEntri.jam_latihan = document.getElementById('field_jam_rr').value;
