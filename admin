        function aksiEditData(kat, id) {
            const item = storageOrganisasi[kat].find(x => x.id.toString() === id.toString());
            if(!item) return;
            document.getElementById('kategoriUtama').value = kat;
            renderFormFields();
            editIdAktif = id;
            if(kat === 'anggota') {
                document.getElementById('field_nia').value = item.nia || '';
                document.getElementById('field_nik').value = item.nik || '';
                document.getElementById('field_kk').value = item.kk || '';
                document.getElementById('field_wa').value = item.whatsapp || '';
                document.getElementById('field_nama').value = item.nama_lengkap;
                document.getElementById('field_jk').value = item.jenis_kelamin;
                document.getElementById('field_tgl').value = item.tanggal_lahir;
                document.getElementById('field_kualifikasi_usia').value = item.kualifikasi_usia;
                document.getElementById('field_rayon_asal').value = item.ranting_rayon;
                document.getElementById('field_alamat').value = item.alamat;
            } else if (kat === 'pelatih' || kat === 'kepengurusan') {
                document.getElementById('field_rayon_asal').value = item.ranting_rayon;
                filterAnggotaOtomatis();
                document.getElementById('field_nama').value = item.nama_lengkap;
                autofillDataTerintegrasi();
                if(kat === 'kepengurusan') {
                    document.getElementById('field_jabatan').value = item.jabatan;
                    document.getElementById('field_tingkat').value = item.tingkat;
                }
            } else if (kat === 'rayon') {
                document.getElementById('field_nama_rr').value = item.nama_rayon_ranting;
                document.getElementById('field_kat_rr').value = item.kategori_rr;
                document.getElementById('field_lokasi_rr').value = item.lokasi_latihan;
                document.getElementById('field_jadwal_rr').value = item.jadwal_hari;
                document.getElementById('field_jam_rr').value = item.jam_latihan;
                document.getElementById('field_pelatih_rr').value = item.pelatih_tetap || "";
            } else if (kat === 'keuangan') {
                document.getElementById('field_tipe_keu').value = item.tipe;
                toggleFormKeuangan();
                document.getElementById('field_tgl_keu').value = item.tanggal;
                document.getElementById('field_nominal_keu').value = item.nominal;
                document.getElementById('field_ket_keu').value = item.keterangan;
            } else if (kat === 'administrasi') {
                document.getElementById('field_jenis_surat').value = item.jenis_surat;
                document.getElementById('field_sub_kat_surat').value = item.sub_kategori;
                document.getElementById('field_tgl_surat').value = item.tanggal_surat;
                document.getElementById('field_no_surat').value = item.nomor_surat;
                document.getElementById('field_perihal_surat').value = item.perihal;
            } else if (kat === 'program_kerja') {
                document.getElementById('field_nama_pk').value = item.nama_proker;
                document.getElementById('field_target_pk').value = item.target;
                document.getElementById('field_status_pk').value = item.status;
            } else if (kat === 'agenda') {
                document.getElementById('field_nama_ag').value = item.nama_kegiatan;
                document.getElementById('field_tgl_ag').value = item.tanggal_kegiatan;
                document.getElementById('field_lokasi_ag').value = item.lokasi_kegiatan;
                document.getElementById('field_penyelenggara_ag').value = item.penyelenggara;
            } else if (kat === 'evaluasi') {
                document.getElementById('field_judul_ev').value = item.judul;
                document.getElementById('field_ket_ev').value = item.keterangan;
                document.getElementById('field_status_ev').value = item.status;
            }
            switchPage('page-form');
        }

